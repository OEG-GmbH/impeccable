#!/bin/sh
# Impeccable launcher, this fork. Runs exactly one engine: the platform binary
# shipped next to this script,
#   <this dir>/bin/<os>-<arch>/impeccable
# verified against engine-checksums.txt (next to this script). There is no
# other candidate (no IMPECCABLE_BIN, no user cache, no PATH lookup) and no
# download: a missing or unverified binary stops the launcher with a message.
# Never needs Node.
#
# The binary is hashed on every run, and nothing is written. Hash and exec
# open the path twice, so before hashing the launcher requires that the
# binary is a regular file (no symlink) owned by the owner of this launcher,
# and that neither the binary nor any directory from this script's directory
# down to it is writable by group or others. Whoever can still swap the
# binary between hash and exec can then also rewrite this launcher, so the
# check adds no weaker trust than the launcher itself has.
#
# Exit status: 3 when no engine binary is installed next to this script (the
# git-delivered copies ship launcher-only: place the fork build there), 127
# when a binary is there but refused; otherwise the engine's own status.
set -eu

# Space, tab and CR, made once: hooks run this launcher on every edit and turn
# end, so the hot path below sticks to shell builtins.
ws=$(printf ' \t\r')

# Sets $digest_out to the digest engine-checksums.txt records for engine
# version $1 and asset $2 (lines are "<version> <asset> <sha256>"), empty when
# there is none.
# A CR is a separator too (CRLF checkouts), and a last line with no newline
# still counts.
manifest_digest() {
  digest_out=""
  [ -f "$manifest" ] || return 0
  while IFS="$ws" read -r m_version m_asset m_sum _ || [ -n "$m_version" ]; do
    case "$m_version" in ''|'#'*) continue ;; esac
    if [ "$m_version" = "$1" ] && [ "$m_asset" = "$2" ]; then
      digest_out=$m_sum
      return 0
    fi
  done < "$manifest"
  return 0
}
# Sets $expected (and, on Windows on ARM, which runs x64 binaries,
# $expected_x64) from engine-checksums.txt.
read_expected() {
  manifest_digest "$version" "$asset"
  expected=$digest_out
  expected_x64=""
  if [ "$os" = windows ] && [ "$arch" = arm64 ]; then
    manifest_digest "$version" impeccable-windows-x64.exe
    expected_x64=$digest_out
  fi
}
# Sets $actual to the sha256 of $1, empty when no hash tool works.
# sha256sum (coreutils, native) first: the launcher hashes on every run, and
# shasum is a Perl script that costs a few hundred ms more. macOS has only
# shasum.
hash_file() {
  actual=""
  if command -v sha256sum >/dev/null 2>&1; then
    if digest=$(sha256sum "$1" 2>/dev/null); then actual=${digest%% *}; fi
  elif command -v shasum >/dev/null 2>&1; then
    if digest=$(shasum -a 256 "$1" 2>/dev/null); then actual=${digest%% *}; fi
  fi
}
# Sets $m_uid and $m_mode (octal permission bits) of $1 without following a
# symlink: GNU stat, then BSD stat. Fails when neither answers.
file_meta() {
  m_out=$(stat -c '%u %a' -- "$1" 2>/dev/null) || m_out=$(stat -f '%u %Lp' -- "$1" 2>/dev/null) || return 1
  m_uid=${m_out%% *}
  m_mode=${m_out##* }
  case $m_uid$m_mode in ''|*[!0-9]*) return 1 ;; esac
}
# Stops unless $1 is owned by $owner and not writable by group or others.
require_private() {
  if ! file_meta "$1"; then
    echo "impeccable: cannot read owner and mode of $1; refusing to run the engine" >&2
    exit 127
  fi
  if [ "$m_uid" != "$owner" ]; then
    echo "impeccable: $1 belongs to uid $m_uid, the launcher to uid $owner; refusing to run the engine" >&2
    exit 127
  fi
  # The group and other digits of the mode; 2, 3, 6 and 7 include write.
  # Padded first: GNU stat prints mode 0007 as "7", which has no two digits.
  m_go=00$m_mode
  m_go=${m_go#"${m_go%??}"}
  case $m_go in
    [2367]?|?[2367])
      echo "impeccable: $1 is writable by group or others (mode $m_mode); refusing to run the engine" >&2
      exit 127 ;;
  esac
}
# Execs $bin with the arguments when it passes the file checks and matches the
# manifest digest; otherwise stops with a message. Never returns.
exec_verified() {
  candidate=$bin
  # Nothing there at all (a dangling symlink is refused below, as a symlink).
  # Checked before the digest, so a launcher-only copy on a platform the
  # manifest does not list yet still says "not installed".
  if [ ! -e "$candidate" ] && [ ! -L "$candidate" ]; then
    echo "impeccable: engine $version is not installed: no binary at $candidate" >&2
    echo "impeccable: the fork downloads nothing. Copy the fork build of $asset there (a regular file owned by the owner of this launcher, not writable by group or others); its sha256 must be the one $manifest lists." >&2
    if [ -z "$expected" ] && [ -z "$expected_x64" ]; then
      echo "impeccable: $manifest lists no digest for engine $version ($asset) yet; add the fork build's sha256 there as well." >&2
    fi
    exit 3
  fi
  if [ -z "$expected" ] && [ -z "$expected_x64" ]; then
    echo "impeccable: no checksum for engine $version ($asset) in $manifest; refusing to run $candidate" >&2
    exit 127
  fi
  if [ -L "$candidate" ] || [ ! -f "$candidate" ]; then
    echo "impeccable: $candidate is not a regular file (or is a symlink). This fork downloads nothing: place the fork build there." >&2
    exit 127
  fi
  if ! file_meta "$launcher"; then
    echo "impeccable: cannot read the owner of $launcher; refusing to run the engine" >&2
    exit 127
  fi
  owner=$m_uid
  for p in "$dir" "$dir/bin" "${candidate%/*}" "$candidate"; do
    if [ -L "$p" ]; then
      echo "impeccable: $p is a symlink; refusing to run the engine" >&2
      exit 127
    fi
    require_private "$p"
  done
  # Lost the executable bit in transit (zip extraction, some copiers).
  [ -x "$candidate" ] || chmod +x "$candidate" 2>/dev/null || :
  hash_file "$candidate"
  if [ -z "$actual" ]; then
    echo "impeccable: cannot verify $candidate (no sha256 tool, or hashing failed); refusing to run it" >&2
    exit 127
  fi
  if [ "$actual" = "$expected" ] || [ "$actual" = "$expected_x64" ]; then
    exec "$candidate" "$@"
  fi
  echo "impeccable: checksum mismatch for $candidate (sha256 $actual, $manifest expects ${expected:-$expected_x64}); refusing to run it" >&2
  exit 127
}

# This script's directory without dirname or a subshell: what dirname "$0"
# gives, made absolute by a cd there and back.
case $0 in
  */*) dir=${0%/*} ;;
  *) dir=. ;;
esac
[ -n "$dir" ] || dir=/
caller_pwd=$PWD
CDPATH= cd -- "$dir" || { echo "impeccable: cannot enter the launcher directory $dir" >&2; exit 127; }
dir=$PWD
skill_dir=${dir%/*}
[ -n "$skill_dir" ] || skill_dir=/
cd -- "$caller_pwd" || { echo "impeccable: cannot return to $caller_pwd" >&2; exit 127; }
launcher="$dir/${0##*/}"
# VS Code syncs a plugin without the executable bit. Its hooks run this through
# sh, so restore the bit for the commands the skill runs directly (#1249).
[ -x "$0" ] || chmod +x "$0" 2>/dev/null || :
manifest="$dir/engine-checksums.txt"

# What the binary needs to know about its home: the skill directory (for
# reference/*.md and command-metadata.json) and how to name itself in the
# commands it prints. Exported before the exec below.
: "${IMPECCABLE_SKILL_DIR:=$skill_dir}"
: "${IMPECCABLE_SELF:=$0}"
export IMPECCABLE_SKILL_DIR IMPECCABLE_SELF

# Windows names itself in the environment, which saves a process there; one
# uname covers the rest. PROCESSOR_ARCHITECTURE is what impeccable.cmd reads.
if [ "${OS:-}" = Windows_NT ]; then
  sys="Windows_NT ${PROCESSOR_ARCHITECTURE:-unknown}"
else
  sys=$(uname -sm 2>/dev/null) || sys="unknown unknown"
fi
case "${sys%% *}" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows ;;
  *) os=unknown ;;
esac
case "${sys##* }" in
  arm64|aarch64|ARM64) arch=arm64 ;;
  x86_64|amd64|AMD64) arch=x64 ;;
  *) arch=unknown ;;
esac

version=""
[ -f "$dir/VERSION" ] && { IFS="$ws" read -r version _ < "$dir/VERSION" || :; }
if [ -z "$version" ]; then
  echo "impeccable: no engine version in $dir/VERSION; refusing to run" >&2
  exit 127
fi
asset="impeccable-$os-$arch"
[ "$os" = windows ] && asset="$asset.exe"
bin="$dir/bin/$os-$arch/impeccable"
[ "$os" = windows ] && bin="$bin.exe"
read_expected

exec_verified "$@"
